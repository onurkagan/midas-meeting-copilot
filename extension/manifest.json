{
  "manifest_version": 3,
  "name": "Midas for Chrome",
  "version": "0.1.0",
  "description": "Sends one call tab's audio to the Midas app on your Mac, so Midas hears the call, not your other tabs.",
  "homepage_url": "https://onurkagan.github.io/midas-meeting-copilot/",
  "minimum_chrome_version": "116",
  "permissions": ["tabCapture", "offscreen", "nativeMessaging", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Send this tab's audio to Midas",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "options_ui": { "page": "consent.html", "open_in_tab": true },
  "content_scripts": [
    { "matches": ["https://meet.google.com/*"], "js": ["meet.js"], "run_at": "document_idle" }
  ],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "key": ""
}
